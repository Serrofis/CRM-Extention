{
  "manifest_version": 3,
  "name": "mod",
  "version": "1.7.305",
  "description": "Welcome Pickups CRM transfer tools with transfer details collection, WhatsApp image copy, batch task tools, and city vehicle capacity info.",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "scripting",
    "alarms",
    "offscreen",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "side_panel": {
    "default_path": "wa-panel.html"
  },
  "host_permissions": [
    "https://crm.welcomepickups.com/*",
    "https://web.whatsapp.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.workers.dev/*",
    "https://*.ts.net/*",
    "https://ops-intelligence-hub.vercel.app/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.slack.com/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "mod",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.welcomepickups.com/admin/transfers/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://crm.welcomepickups.com/admin/transfers/*"
      ],
      "js": [
        "wp-broadcast-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://crm.welcomepickups.com/admin/tour_transfers/*",
        "https://crm.welcomepickups.com/admin/drivers*",
        "https://welcomepickups.atlassian.net/wiki/spaces/IKB/pages/3862102017/*"
      ],
      "js": [
        "wp-tours.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wp-whatsapp.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ops-intelligence-hub.vercel.app/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*"
      ],
      "js": [
        "wp-hub.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wp-whatsapp-main.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "wp-clipboard-hook.js",
        "wp-broadcast-hook.js"
      ],
      "matches": [
        "https://crm.welcomepickups.com/*"
      ]
    }
  ]
}
